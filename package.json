    "ini": "^1.3.8",
    "ip": "^1.1.9",
    "js-yaml": "^3.15.2",
    "karma": "$karma",
    "loader-utils": "^1.4.2",
    "lodash": "^4.18.1",
    "minimist": "^1.2.8"
